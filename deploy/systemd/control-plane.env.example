# /etc/prestige-replica-manager/control-plane.env — mode 0600, propriétaire prm.
PRM_HTTP_HOST=127.0.0.1
PRM_INSECURE_REQUESTS=disabled
PRM_TLS_CERT=/etc/prestige-replica-manager/tls/console.pem
PRM_TLS_KEY=/etc/prestige-replica-manager/tls/console.key
PRM_DB_URL=jdbc:postgresql://127.0.0.1:5432/prm
PRM_DB_USER=prm
PRM_DB_PASSWORD=changer-moi
# Clé de chiffrement des cookies de session (32 caractères aléatoires minimum).
PRM_SESSION_KEY=changer-moi-par-une-valeur-aleatoire
# Utilisé uniquement au premier démarrage, puis à retirer.
PRM_BOOTSTRAP_ADMIN_PASSWORD=
PRM_SMTP_HOST=127.0.0.1
PRM_MAIL_FROM=replication@exemple.ci
